# ============================================================
#  Android .gitignore
# ============================================================

# ----------------------------
# Gradle
# ----------------------------
.gradle/
build/
**/build/
gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.jar
.gradletasknamecache

# ----------------------------
# Android Studio / IntelliJ IDEA
# ----------------------------
*.iml
.idea/
.idea/workspace.xml
.idea/tasks.xml
.idea/gradle.xml
.idea/assetWizardSettings.xml
.idea/dictionaries
.idea/libraries
.idea/caches
.idea/.name
.idea/compiler.xml
.idea/jarRepositories.xml
.idea/modules.xml
.idea/misc.xml
*.iws
out/

# ----------------------------
# Local configuration (macchina locale)
# ----------------------------
local.properties
keystore.properties

# ----------------------------
# Keystore e certificati (NON committare mai!)
# ----------------------------
*.jks
*.keystore
*.p12
*.pfx

# ----------------------------
# File generati
# ----------------------------
gen/
bin/
app/release/
app/debug/

# ----------------------------
# NDK / CMake
# ----------------------------
.externalNativeBuild/
.cxx/
*.so

# ----------------------------
# Lint
# ----------------------------
lint/

# ----------------------------
# ProGuard / R8 mapping
# ----------------------------
mapping.txt
seeds.txt
usage.txt

# ----------------------------
# Google Services
# ----------------------------
google-services.json
# Decommentare se non si usa Firebase:
# google-services.json

# ----------------------------
# Captures / Profiler
# ----------------------------
captures/
*.hprof

# ----------------------------
# Testing
# ----------------------------
.DS_Store
.test_results/

# ----------------------------
# macOS
# ----------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# ----------------------------
# Windows
# ----------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ----------------------------
# Linux
# ----------------------------
*~

# ----------------------------
# Variabili d'ambiente e segreti
# ----------------------------
.env
.env.local
.env.*.local
secrets.properties
api_keys.xml

# ----------------------------
# Fastlane (CI/CD)
# ----------------------------
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output
fastlane/readme.md

# ----------------------------
# Firebase / Crashlytics
# ----------------------------
.firebase/
firebase.json

# ----------------------------
# Kotlin DSL cache
# ----------------------------
buildSrc/.gradle/
buildSrc/build/