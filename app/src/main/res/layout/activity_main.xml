<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:clipChildren="false"
    android:clipToPadding="false"
    tools:context=".MainActivity">

    <!-- Top Header Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerContainer"
        android:layout_width="0dp"
        android:layout_height="@dimen/header_height"
        android:background="#FF000000"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:id="@+id/streamStatusDot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginStart="16dp"
            android:background="@drawable/bg_status_dot"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:id="@+id/headerTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/app_name"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/streamStatusDot" />

        <TextView
            android:id="@+id/settingsTopButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/header_padding_horizontal"
            android:text="UHD\n60"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textAlignment="center"
            android:gravity="center"
            android:textStyle="bold"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:id="@+id/focusTopButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="AF"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textAlignment="center"
            android:gravity="center"
            android:textStyle="bold"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp"
            app:layout_constraintEnd_toStartOf="@id/settingsTopButton"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <io.github.thibaultbee.streampack.ui.views.PreviewView
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/headerContainer" />

    <!-- Settings Overlay Panel -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/settingsPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_rounded_panel"
        android:padding="24dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/dimLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dimensioni"
            android:textColor="@color/white"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/dimGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginStart="24dp"
            app:layout_constraintStart_toEndOf="@id/dimLabel"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="@id/dimLabel">

            <TextView android:id="@+id/res8k" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="8K" android:textColor="@color/white" android:textSize="14sp" android:textStyle="bold" android:layout_marginStart="16dp" android:padding="8dp" android:clickable="true" android:focusable="true"/>
            <TextView android:id="@+id/resUhd" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="UHD" android:textColor="@color/accent" android:textSize="14sp" android:textStyle="bold" android:layout_marginStart="16dp" android:padding="8dp" android:clickable="true" android:focusable="true"/>
            <TextView android:id="@+id/resFhd" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="FHD" android:textColor="@color/white" android:textSize="14sp" android:textStyle="bold" android:layout_marginStart="16dp" android:padding="8dp" android:clickable="true" android:focusable="true"/>
            <TextView android:id="@+id/resHd" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="HD" android:textColor="@color/white" android:textSize="14sp" android:textStyle="bold" android:layout_marginStart="16dp" android:padding="8dp" android:clickable="true" android:focusable="true"/>
        </LinearLayout>

        <TextView
            android:id="@+id/fpsLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FPS"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:layout_marginTop="24dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/dimLabel" />

        <LinearLayout
            android:id="@+id/fpsGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginStart="24dp"
            app:layout_constraintStart_toEndOf="@id/fpsLabel"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/fpsLabel"
            app:layout_constraintBottom_toBottomOf="@id/fpsLabel">

            <TextView android:id="@+id/fps60" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="60" android:textColor="@color/accent" android:textSize="14sp" android:textStyle="bold" android:layout_marginEnd="32dp" android:padding="8dp" android:clickable="true" android:focusable="true"/>
            <TextView android:id="@+id/fps30" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="30" android:textColor="@color/white" android:textSize="14sp" android:textStyle="bold" android:padding="8dp" android:clickable="true" android:focusable="true"/>
        </LinearLayout>



    </androidx.constraintlayout.widget.ConstraintLayout>


    <!-- Focus Control Panel -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/focusPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_rounded_panel"
        android:padding="24dp"
        android:minWidth="260dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/focusLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Focus"
            android:textColor="@color/white"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/focusModeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AUTO"
            android:textColor="@color/accent"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginStart="16dp"
            app:layout_constraintStart_toEndOf="@id/focusLabel"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/focusLabel"
            app:layout_constraintBottom_toBottomOf="@id/focusLabel" />

        <TextView
            android:id="@+id/focusNearLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AUTO"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:layout_marginTop="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/focusLabel" />

        <SeekBar
            android:id="@+id/focusSeekBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/accent"
            android:thumbTint="@color/accent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/focusNearLabel" />

        <TextView
            android:id="@+id/focusFarLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="∞"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:layout_marginTop="4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/focusSeekBar" />

    </androidx.constraintlayout.widget.ConstraintLayout>


    <!-- Bottom Control Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottomBar"
        android:layout_width="0dp"
        android:layout_height="120dp"
        android:background="@android:color/transparent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ToggleButton
            android:id="@+id/liveButton"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/ic_live_button"
            android:textColor="@android:color/transparent"
            android:textOff=""
            android:textOn=""
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Energy Saving Toggle Button -->
        <ImageButton
            android:id="@+id/energySavingButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_lock_power_off"
            app:tint="@color/white"
            android:scaleType="centerInside"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/liveButton"
            app:layout_constraintBottom_toBottomOf="@+id/liveButton" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Fullscreen Black Overlay for Energy Saving Mode -->
    <View
        android:id="@+id/energySavingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:elevation="100dp"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>